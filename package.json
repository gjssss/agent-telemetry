{
  "name": "agent-telemetry",
  "type": "module",
  "version": "0.1.0",
  "description": "Agent Telemetry CLI with bundled frontend and backend",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "agent-telemetry": "packages/cli/dist/cli.js"
  },
  "files": [
    "packages/cli/dist"
  ],
  "scripts": {
    "server": "bun run --filter @agent-telemetry/cli start -- server",
    "build": "bun run --filter @agent-telemetry/cli build",
    "typecheck": "bun run --workspaces --sequential typecheck"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "hono": "^4.12.9"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@eslint-react/eslint-plugin": "^2.13.0",
    "@types/bun": "^1.3.5",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2"
  }
}
