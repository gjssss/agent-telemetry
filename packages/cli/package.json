{
  "name": "@agent-telemetry/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Telemetry CLI built with Bun and Vite",
  "type": "module",
  "bin": {
    "agent-telemetry": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run scripts/build-web.ts",
    "build:cli": "tsc -p tsconfig.json --noEmit && vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "bun dist/cli.js"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@agent-telemetry/core": "workspace:*",
    "@types/bun": "^1.3.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
